<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 720" width="1280" height="720">
  <rect width="1280" height="720" fill="#f1f5fa" />
  <rect x="0" y="0" width="1280" height="720" fill="url(#grid)" />
  
  <defs>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#004aad" stroke-opacity="0.1" stroke-width="1"/>
    </pattern>
  </defs>
  
  <!-- Server Icons -->
  <rect x="240" y="200" width="200" height="280" rx="10" fill="#004aad" fill-opacity="0.1" stroke="#004aad" stroke-opacity="0.3" stroke-width="2"/>
  <rect x="260" y="240" width="160" height="20" rx="4" fill="#004aad" fill-opacity="0.2"/>
  <rect x="260" y="270" width="140" height="20" rx="4" fill="#004aad" fill-opacity="0.2"/>
  <rect x="260" y="300" width="160" height="20" rx="4" fill="#004aad" fill-opacity="0.2"/>
  <rect x="260" y="330" width="120" height="20" rx="4" fill="#004aad" fill-opacity="0.2"/>
  
  <!-- Database -->
  <ellipse cx="840" cy="250" rx="120" ry="40" fill="#004aad" fill-opacity="0.1" stroke="#004aad" stroke-opacity="0.3" stroke-width="2"/>
  <rect x="720" y="250" width="240" height="100" fill="#004aad" fill-opacity="0.1" stroke="#004aad" stroke-opacity="0.3" stroke-width="2"/>
  <ellipse cx="840" cy="350" rx="120" ry="40" fill="#004aad" fill-opacity="0.1" stroke="#004aad" stroke-opacity="0.3" stroke-width="2"/>
  
  <!-- Connection Lines -->
  <path d="M 440 300 L 720 300" stroke="#004aad" stroke-opacity="0.4" stroke-width="3" stroke-dasharray="10,5"/>
  <path d="M 840 350 L 840 400 L 600 400 L 600 460" stroke="#004aad" stroke-opacity="0.4" stroke-width="3" stroke-dasharray="10,5"/>
  
  <!-- Device Icon -->
  <rect x="500" y="460" width="200" height="120" rx="10" fill="#004aad" fill-opacity="0.1" stroke="#004aad" stroke-opacity="0.3" stroke-width="2"/>
  <rect x="520" y="480" width="160" height="80" rx="4" fill="white" stroke="#004aad" stroke-opacity="0.3" stroke-width="1"/>
  
  <!-- Text -->
  <text x="640" y="630" font-family="Arial, sans-serif" font-size="36" fill="#004aad" text-anchor="middle" font-weight="bold">Citizen Deployment Demo</text>
</svg> 